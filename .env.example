# HTTP
PORT=8787
HOST=127.0.0.1
# Set to 1 when running behind Caddy, so the real client IP is used for lockouts.
TRUST_PROXY=1
PUBLIC_URL=https://cerebro.valdoh.com

# Storage
DATA_DIR=./data

# Admin panel (/admin). At least 16 characters; the panel is disabled otherwise.
ADMIN_PASSWORD=

# Worker
WORKER_ENABLED=1
WORKER_POLL_SECONDS=15
# Claude Code in --bare mode only accepts an API key (no OAuth / keychain).
ANTHROPIC_API_KEY=
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_BUDGET_USD=3
GIT_AUTHOR_NAME=coordinating-brain[bot]
GIT_AUTHOR_EMAIL=coordinating-brain@users.noreply.github.com

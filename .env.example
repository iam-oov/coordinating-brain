# HTTP
PORT=8791
HOST=127.0.0.1
TRUST_PROXY=1
PUBLIC_URL=https://cerebro.valdoh.com

# Storage
DATA_DIR=./data

# Google sign-in
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
ADMIN_EMAILS=

# Worker
WORKER_ENABLED=1
WORKER_POLL_SECONDS=15
SANDBOX=systemd
SANDBOX_DIR=/var/lib/cb-sandbox
# Claude Code in --bare mode only accepts an API key (no OAuth / keychain).
ANTHROPIC_API_KEY=
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_BUDGET_USD=3
GIT_AUTHOR_NAME=coordinating-brain[bot]
GIT_AUTHOR_EMAIL=coordinating-brain@users.noreply.github.com

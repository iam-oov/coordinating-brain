# /etc/systemd/system/coordinating-brain.service
[Unit]
Description=coordinating-brain (improvement requests -> Claude Code -> APK)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brain
Group=brain
WorkingDirectory=/opt/coordinating-brain
EnvironmentFile=/opt/coordinating-brain/.env
# Flutter, the Android SDK and Claude Code must be on the PATH of the brain user.
Environment=PATH=/home/brain/flutter/bin:/home/brain/android-sdk/cmdline-tools/latest/bin:/home/brain/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ANDROID_HOME=/home/brain/android-sdk
ExecStart=/usr/bin/env node src/main.ts
Restart=on-failure
RestartSec=5
# A build can take several minutes; a killed request is queued again on start.
TimeoutStopSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

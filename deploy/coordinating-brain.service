# /etc/systemd/system/coordinating-brain.service
[Unit]
Description=coordinating-brain (improvement requests -> Claude Code -> APK)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coordinating-brain
Group=coordinating-brain
WorkingDirectory=/home/coordinating-brain/coordinating-brain
EnvironmentFile=/home/coordinating-brain/coordinating-brain/.env
Environment=PATH=/home/coordinating-brain/flutter/bin:/home/coordinating-brain/android-sdk/cmdline-tools/latest/bin:/home/coordinating-brain/android-sdk/platform-tools:/home/coordinating-brain/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ANDROID_HOME=/home/coordinating-brain/android-sdk
ExecStart=/usr/local/bin/node src/main.ts
Restart=on-failure
RestartSec=5
# A build can take several minutes; a killed request is queued again on start.
TimeoutStopSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
